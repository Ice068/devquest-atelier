# DevQuest Atelier — Environment Configuration
# Copy this file to .env and replace secrets before running in production.

APP_NAME="DevQuest Atelier"
ENVIRONMENT="development"

# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="dev-only-change-me-in-production-use-64-random-chars-minimum"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5501,http://localhost:5501"

# Set to false in production to disable Swagger/ReDoc
ENABLE_DOCS=true

# Storage backend: "local" (zero-config JSON store) or "firestore" (Firebase Admin SDK)
STORAGE_BACKEND="local"
LOCAL_DB_PATH="data/local_db.json"
FIREBASE_CREDENTIALS_PATH="firebase-service-account.json"

# Optional: Google Gemini API for AI SOLO Coach (falls back to built-in AST SOLO Engine when empty)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
